diff --git a/ports/rp2/modusb_midi.c b/ports/rp2/modusb_midi.c
new file mode 100644
--- /dev/null
+++ b/ports/rp2/modusb_midi.c
@@ -0,0 +1,63 @@
+#include <stdio.h>
+#include "py/runtime.h"
+#ifndef NO_QSTR
+#include "tusb.h"
+#endif
+
+extern tusb_desc_device_t mp_usbd_builtin_desc_dev;
+extern char mp_usbd_custom_manufacturer[64];
+extern char mp_usbd_custom_product[64];
+extern char mp_usbd_custom_serial[64];
+
+static mp_obj_t usb_midi_set_info(size_t n_args, const mp_obj_t *args) {
+    if (n_args >= 2) {
+        mp_usbd_builtin_desc_dev.idVendor = mp_obj_get_int(args[0]);
+        mp_usbd_builtin_desc_dev.idProduct = mp_obj_get_int(args[1]);
+    }
+    if (n_args >= 3) {
+        const char *m = mp_obj_str_get_str(args[2]);
+        snprintf(mp_usbd_custom_manufacturer, sizeof(mp_usbd_custom_manufacturer), "%s", m);
+    }
+    if (n_args >= 4) {
+        const char *p = mp_obj_str_get_str(args[3]);
+        snprintf(mp_usbd_custom_product, sizeof(mp_usbd_custom_product), "%s", p);
+    }
+    if (n_args >= 5) {
+        const char *s = mp_obj_str_get_str(args[4]);
+        snprintf(mp_usbd_custom_serial, sizeof(mp_usbd_custom_serial), "%s", s);
+    }
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(usb_midi_set_info_obj, 2, 5, usb_midi_set_info);
+
+static mp_obj_t usb_midi_write(mp_obj_t buf_in) {
+    mp_buffer_info_t bufinfo;
+    mp_get_buffer_raise(buf_in, &bufinfo, MP_BUFFER_READ);
+    uint32_t written = tud_midi_stream_write(0, bufinfo.buf, bufinfo.len);
+    return mp_obj_new_int(written);
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(usb_midi_write_obj, usb_midi_write);
+
+static mp_obj_t usb_midi_read(mp_obj_t len_in) {
+    uint32_t len = mp_obj_get_int(len_in);
+    vstr_t vstr;
+    vstr_init_len(&vstr, len);
+    uint32_t read = tud_midi_stream_read(0, vstr.buf, len);
+    vstr.len = read;
+    return mp_obj_new_bytes_from_vstr(&vstr);
+}
+static MP_DEFINE_CONST_FUN_OBJ_1(usb_midi_read_obj, usb_midi_read);
+
+static const mp_rom_map_elem_t usb_midi_module_globals_table[] = {
+    { MP_ROM_QSTR(MP_QSTR___name__), MP_ROM_QSTR(MP_QSTR_usb_midi) },
+    { MP_ROM_QSTR(MP_QSTR_write), MP_ROM_PTR(&usb_midi_write_obj) },
+    { MP_ROM_QSTR(MP_QSTR_read), MP_ROM_PTR(&usb_midi_read_obj) },
+    { MP_ROM_QSTR(MP_QSTR_set_info), MP_ROM_PTR(&usb_midi_set_info_obj) },
+};
+MP_DEFINE_CONST_DICT(usb_midi_module_globals, usb_midi_module_globals_table);
+
+const mp_obj_module_t usb_midi_module = {
+    .base = { &mp_type_module },
+    .globals = (mp_obj_dict_t *)&usb_midi_module_globals,
+};
+MP_REGISTER_MODULE(MP_QSTR_usb_midi, usb_midi_module);
